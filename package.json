{
  "name": "@constroad/shared",
  "version": "0.17.0",
  "private": true,
  "description": "Código de dominio compartido entre las apps de ConstRoad: planilla, consumos, flota, mapa de obra e informes de campo. Puro y sin dependencias; solo `./cubicar` trae React (peer).",
  "license": "UNLICENSED",
  "exports": {
    "./planilla": {
      "types": "./dist/planilla/index.d.ts",
      "default": "./dist/planilla/index.js"
    },
    "./consumos": {
      "types": "./dist/consumos/index.d.ts",
      "default": "./dist/consumos/index.js"
    },
    "./flota": {
      "types": "./dist/flota/index.d.ts",
      "default": "./dist/flota/index.js"
    },
    "./obra": {
      "types": "./dist/obra/index.d.ts",
      "default": "./dist/obra/index.js"
    },
    "./informes": {
      "types": "./dist/informes/index.d.ts",
      "default": "./dist/informes/index.js"
    },
    "./kardex": {
      "types": "./dist/kardex/index.d.ts",
      "default": "./dist/kardex/index.js"
    },
    "./materiales": {
      "types": "./dist/materiales/index.d.ts",
      "default": "./dist/materiales/index.js"
    },
    "./casos.json": "./casos.json",
    "./cubicar": {
      "types": "./dist/cubicar/index.d.ts",
      "default": "./dist/cubicar/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "planilla": [
        "dist/planilla/index.d.ts"
      ],
      "consumos": [
        "dist/consumos/index.d.ts"
      ],
      "flota": [
        "dist/flota/index.d.ts"
      ],
      "obra": [
        "dist/obra/index.d.ts"
      ],
      "informes": [
        "dist/informes/index.d.ts"
      ],
      "kardex": [
        "dist/kardex/index.d.ts"
      ],
      "materiales": [
        "dist/materiales/index.d.ts"
      ],
      "cubicar": [
        "dist/cubicar/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "casos.json"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^21.0.4",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
