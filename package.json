{
  "name": "@constroad/shared",
  "version": "0.2.1",
  "private": true,
  "description": "Código de dominio compartido entre las apps de ConstRoad: planilla y consumos. Puro y sin dependencias.",
  "license": "UNLICENSED",
  "exports": {
    "./planilla": {
      "types": "./dist/planilla/index.d.ts",
      "default": "./dist/planilla/index.js"
    },
    "./consumos": {
      "types": "./dist/consumos/index.d.ts",
      "default": "./dist/consumos/index.js"
    },
    "./casos.json": "./casos.json"
  },
  "typesVersions": {
    "*": {
      "planilla": [
        "dist/planilla/index.d.ts"
      ],
      "consumos": [
        "dist/consumos/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "casos.json"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
